# Environment for deploying the Vezta launchpad to Ethereum Sepolia.
# Copy to .env (git-ignored) and fill in. Foundry loads .env automatically from this directory.
#
#   cp .env.example .env
#   source .env   # only needed if you run cast/shell commands; forge reads .env by itself
#
#   GIT_COMMIT=$(git rev-parse --short HEAD) \
#     forge script script/Deploy.s.sol --rpc-url sepolia --broadcast --verify
#
# A broadcast run writes deployments/sepolia.json. Copy it to the app:
#
#   cp deployments/sepolia.json ../TokenLaunchPadProject/packages/deployments/sepolia.json
#
# Then run the app with DEPLOYMENT=sepolia (packages/deployments loadDeployment() reads it).

# --- Network (foundry.toml: [rpc_endpoints] sepolia, [etherscan] sepolia) ---------------------------
# Sepolia JSON-RPC endpoint (Alchemy / Infura / QuickNode ...). Chain id 11155111.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<your-project-id>

# Etherscan API key, used by `--verify`.
ETHERSCAN_API_KEY=<your-etherscan-api-key>

# --- Deploy parameters (script/Deploy.s.sol) ---------------------------------------------------------
# Selects deploy/<DEPLOY_CONFIG>.json (owner, fees, router, pairInitCodeHash, graduation amount)
# and names the output deployments/<DEPLOY_CONFIG>.json.
DEPLOY_CONFIG=sepolia

# --- Deployer wallet ------------------------------------------------------------------------------------
# Preferred: an encrypted keystore created with `cast wallet import <name> --interactive`
# (stored in ~/.foundry/keystores). forge reads this as `--account`.
ETH_KEYSTORE_ACCOUNT=<keystore-name>
# Optional: file holding the keystore password, so forge does not prompt. Keep it outside the repo.
# ETH_PASSWORD=/path/to/keystore-password.txt

# Alternative for throwaway testnet keys only (then pass `--private-key $DEPLOYER_PRIVATE_KEY`).
# Never use a key that holds real funds, and never commit it.
# DEPLOYER_PRIVATE_KEY=0x...

# --- Recorded in deployments/<name>.json -------------------------------------------------------------
# .env files are not evaluated by a shell, so set this inline instead:
#   GIT_COMMIT=$(git rev-parse --short HEAD) forge script ...
# GIT_COMMIT=unknown
